{
    "name": "demonray-launcher",
    "productName": "DemonRay Launcher",
    "version": "1.0.1",
    "description": "Launcher pour le serveur RP - DemonRay",
    "main": "src/app.js",
    "author": "EnOx_S, AXO, Riptiaz/Boulldogo/Vexato/Luuxis",
    "env": "panel",
    "settings": "https://web-enoxs.prismo-host.fr",
    "scripts": {
        "start": "cross-env-shell NODE_ENV=dev electron .",
        "build": "node build.js --obf=true --build=platform",
        "dev": "cross-env-shell DEV_TOOL=open nodemon --ignore AppData/ --ignore node_modules/ --legacy-watch --exec npm start",
        "icon": "node build.js --icon=https://raw.githubusercontent.com/EnOx-S/DemonRayLauncher/master/src/assets/images/icon.png"
    },
    "license": "CC0",
    "nodemonConfig": {
        "ext": "js,html,css"
    },
    "dependencies": {
        "discord-rpc": "^4.0.1",
        "electron-updater": "^6.6.2",
        "https": "^1.0.0",
        "minecraft-java-core-azbetter": "^4.1.4",
        "node-fetch": "^2.6.7",
        "xml-js": "^1.6.11"
    },
    "devDependencies": {
        "@electron/rebuild": "^4.0.4",
        "cross-env": "^7.0.3",
        "electron": "^42.1.0",
        "electron-builder": "^26.6.0",
        "javascript-obfuscator": "^4.1.0",
        "jimp": "^1.6.1",
        "node-abi": "^4.31.0",
        "nodemon": "^3.1.9",
        "png2icons": "^2.0.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/EnOx-S/DemonRayLauncher.git"
    }
}
